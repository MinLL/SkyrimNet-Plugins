{
  "skyrimnet_knowledge_pack": {
    "description": "Locations and NPCs added to the College of Winterhold when combining Immersive College of Winterhold, Obscure's College of Winterhold, and Immersive College NPCs",
    "entries": [
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Thelsa Andalas is the College's alchemy instructor and keeper of Thelsa's Cantina in the Hall of Acumen. She sells food, drink, potions, recipes, and ingredients to students and faculty. Many College members know her as much for her practical supplies and strange little potion experiments as for her formal instruction — she is skilled enough to train serious alchemists to a high level.",
        "display_name": "NPC: Thelsa Andalas - Alchemy Instructor",
        "emotion": "",
        "importance": 0.8500000238418579,
        "key": "npc-thelsa-andalas-alchemy-instructor",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Thelsa Andalas",
          "alchemy instructor",
          "Thelsa's Cantina",
          "potions",
          "recipes",
          "ingredients",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Agroa Muguk is one of the newer apprentices at the College, known for studying Alteration rather than the flashier destructive arts. Like many apprentices, she is still proving herself among older and more accomplished mages, but her chosen school marks her as someone interested in structure, protection, transmutation, and the deeper rules by which magic reshapes the world.",
        "display_name": "NPC: Agroa Muguk - Alteration Apprentice",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "npc-agroa-muguk-alteration-apprentice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Agroa Muguk",
          "apprentice",
          "Alteration",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Dra'ba Tovi is a Khajiit apprentice at the College, pursuing the dangerous and highly visible discipline of Destruction. As one of the newer students, Dra'ba Tovi helps make the College feel like an active school rather than a closed circle of senior mages. His studies place him among those apprentices most likely to be found near practice targets, lectures, or warded training spaces.",
        "display_name": "NPC: Dra'ba Tovi - Khajiit Destruction Apprentice",
        "emotion": "",
        "importance": 0.7200000286102295,
        "key": "npc-draba-tovi-khajiit-destruction-apprentice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Dra'ba Tovi",
          "Khajiit",
          "apprentice",
          "Destruction",
          "newer student",
          "practice targets",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Estyon is an Altmer apprentice associated with Illusion magic, a field that demands subtlety, patience, and a willingness to study the mind as much as the spell. Among the College's newer students, Estyon stands out less as a battlefield mage and more as someone drawn to perception, misdirection, fear, calm, frenzy, and the strange power of magic over thought and emotion.",
        "display_name": "NPC: Estyon - Altmer Illusion Apprentice",
        "emotion": "",
        "importance": 0.7099999785423279,
        "key": "npc-estyon-altmer-illusion-apprentice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Estyon",
          "Altmer",
          "apprentice",
          "Illusion",
          "newer student",
          "mind magic",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Kassandra Atarax is a newer apprentice at the College whose studies lean toward Conjuration. She is still early in her training, but Conjuration is never treated lightly at Winterhold, since even novice summoning work touches on bound weapons, daedra, spirits, and the calling of forces best handled with discipline and close supervision.",
        "display_name": "NPC: Kassandra Atarax - Conjuration Apprentice",
        "emotion": "",
        "importance": 0.7099999785423279,
        "key": "npc-kassandra-atarax-conjuration-apprentice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Kassandra Atarax",
          "apprentice",
          "Conjuration",
          "newer student",
          "summoning",
          "bound weapons",
          "daedra",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Raddsgar is a Nord apprentice at the College who studies Destruction, placing him in one of the most direct and hazardous schools of magic. His presence is a reminder that not every Nord distrusts spellcraft, and that Winterhold still draws would-be mages from across Skyrim, including those willing to face suspicion from their own countrymen in order to master the arcane arts.",
        "display_name": "NPC: Raddsgar - Nord Destruction Apprentice",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "npc-raddsgar-nord-destruction-apprentice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Raddsgar",
          "Nord",
          "apprentice",
          "Destruction",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Onuja is an Argonian novice at the College of Winterhold, known among the newer students for an unusual aptitude in Illusion. His studies make him less outwardly dramatic than the fire-hurling apprentices, but no less serious; magic that bends perception and steadies or unsettles the mind can be as dangerous as any flame spell in the wrong hands.",
        "display_name": "NPC: Onuja - Argonian Illusion Novice",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "npc-onuja-argonian-illusion-novice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Onuja",
          "Argonian",
          "novice",
          "Illusion",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Nelysa is a Dunmer novice studying at the College, with a particular interest in Destruction magic. Like many young mages from Morrowind's people, she carries herself among Nords with a certain guarded independence, and her chosen school marks her as someone learning to turn raw elemental force into disciplined spellcraft.",
        "display_name": "NPC: Nelysa - Dunmer Destruction Novice",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "npc-nelysa-dunmer-destruction-novice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Nelysa",
          "Dunmer",
          "novice",
          "Destruction",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Sameth is a Breton novice of the College who studies Alteration, a school well suited to those who prefer cleverness and control over brute magical force. His work concerns protection, transmutation, and the hidden laws beneath ordinary matter, making him the sort of student who is often underestimated until a spell turns aside a blade or reshapes the battlefield.",
        "display_name": "NPC: Sameth - Breton Alteration Novice",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "npc-sameth-breton-alteration-novice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Sameth",
          "Breton",
          "novice",
          "Alteration",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Myvrana Giladren is a Bosmer novice at the College, associated with Restoration and ward practice. Her training is less showy than Destruction or Conjuration, but the College values mages who can mend wounds, guard against hostile spells, and keep themselves alive when magical study proves more dangerous than expected.",
        "display_name": "NPC: Myvrana Giladren - Bosmer Restoration Novice",
        "emotion": "",
        "importance": 0.7099999785423279,
        "key": "npc-myvrana-giladren-bosmer-restoration-novice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Myvrana Giladren",
          "Bosmer",
          "novice",
          "Restoration",
          "wards",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Melker is a Nord novice at the College who studies Destruction, making him a rare but telling answer to the claim that Nords have no use for magic. His presence among the apprentices shows that Winterhold still draws Skyrim-born students willing to face suspicion, cold, and ridicule in order to master the arcane arts.",
        "display_name": "NPC: Melker - Nord Destruction Novice",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "npc-melker-nord-destruction-novice",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Melker",
          "Nord",
          "novice",
          "Destruction",
          "newer student",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Lentilus Batiatus is an Imperial mage at the College, known as a capable Conjurer and something of a lone wolf. He keeps more to himself than many of the other instructors and students, and his work with summoned forces, bound magic, and disciplined isolation gives him a reputation for seriousness rather than warmth.",
        "display_name": "NPC: Lentilus Batiatus - Imperial Conjurer",
        "emotion": "",
        "importance": 0.7599999904632568,
        "key": "npc-lentilus-batiatus-imperial-conjurer",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Lentilus Batiatus",
          "Imperial",
          "Conjurer",
          "summoning",
          "bound magic",
          "reserved",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Amanra Solas is a Redguard Restoration expert at the College who teaches the healing arts. She represents the practical, necessary side of magical learning: keeping students alive, training mages in recovery and protection, and reminding the College that mastery is not only measured by how much power one can unleash, but by what one can preserve.",
        "display_name": "NPC: Amanra Solas - Redguard Restoration Expert",
        "emotion": "",
        "importance": 0.7799999713897705,
        "key": "npc-amanra-solas-redguard-restoration-expert",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Amanra Solas",
          "Redguard",
          "Restoration instructor",
          "healing",
          "recovery",
          "protection",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Tarakel is a Redguard mage who teaches wards and maintains a connection to the Saarthal dig, making trips there on weekends. His work places him between classroom discipline and field scholarship, since warding magic is vital both for surviving hostile spells and for protecting excavations where old Nordic ruins may still hold dangerous enchantments.",
        "display_name": "NPC: Tarakel - Redguard Ward Instructor",
        "emotion": "",
        "importance": 0.7699999809265137,
        "key": "npc-tarakel-redguard-ward-instructor",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Tarakel",
          "Redguard",
          "ward instructor",
          "Saarthal",
          "excavation",
          "field scholarship",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Vaktis is the College's groundskeeper, responsible for the unglamorous but essential work of keeping the place orderly despite the snow, salt wind, students, summoned creatures, and magical accidents. Every school needs someone who notices the messes mages leave behind, and Vaktis is part of what makes the College feel like a functioning institution rather than a tower full of isolated scholars.",
        "display_name": "NPC: Vaktis - College Groundskeeper",
        "emotion": "",
        "importance": 0.7200000286102295,
        "key": "npc-vaktis-college-groundskeeper",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "Vaktis",
          "groundskeeper",
          "maintenance",
          "practical work",
          "College of Winterhold"
        ],
        "type": "RELATIONSHIP"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "The Hall of Acumen is one of the College's principal towers, serving as a hub for practical study, alchemical work, and the everyday life of the College. It's where apprentices and scholars gather for food, supplies, conversation, and focused study, making it feel more like an actual school of magic than an isolated fortress.",
        "display_name": "Location: Hall of Acumen",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "location-hall-of-acumen",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Hall of Acumen",
          "tower",
          "practical study",
          "alchemy",
          "apprentices",
          "dining",
          "gathering"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Thelsa's Cantina is the College's informal dining and refreshment hall, run by Thelsa Andalas, an alchemist who sells food, drink, potions, recipes, and ingredients. It's one of the best places to hear gossip, watch academic rivalries unfold, and find mages willing to speak candidly outside the formality of the lecture halls.",
        "display_name": "Location: Thelsa's Cantina",
        "emotion": "",
        "importance": 0.5,
        "key": "location-thelsas-cantina",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Thelsa's Cantina",
          "dining hall",
          "gathering space",
          "gossip",
          "Thelsa Andalas",
          "food",
          "potions",
          "refreshment"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Beneath the main lecture space of the Hall of the Elements lies a lower level devoted to practical magical training and experimentation. Students can practice destructive spells, test wards and defenses, use laboratory facilities, and face magical sparring hazards — a controlled proving ground for applied magic.",
        "display_name": "Location: Hall of the Elements Lower Level",
        "emotion": "",
        "importance": 0.5,
        "key": "location-hall-of-the-elements-lower-level",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Hall of the Elements",
          "lower level",
          "practical training",
          "experimentation",
          "sparring",
          "laboratory",
          "destructive spells",
          "ward testing"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "The Hall of Countenance contains a quiet study area where College residents can read, organize books, and pursue focused research away from the bustle of communal spaces. It is a practical retreat for mages who prefer deep study, private notes, and late-night scholarship to public socializing.",
        "display_name": "Location: Hall of Countenance Study Room",
        "emotion": "",
        "importance": 0.5,
        "key": "location-hall-of-countenance-study-room",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Hall of Countenance",
          "study room",
          "library",
          "research",
          "quiet space",
          "reading",
          "scholarship"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "The Hall of Attainment's kitchen provides the student residence with a proper place for cooking and daily living. It is an essential but humble space that makes the College feel inhabited year-round, especially for apprentices who must prepare their own meals rather than relying on conjuration.",
        "display_name": "Location: Hall of Attainment Kitchen",
        "emotion": "",
        "importance": 0.5,
        "key": "location-hall-of-attainment-kitchen",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Hall of Attainment",
          "kitchen",
          "residential",
          "daily life",
          "food preparation",
          "cooking",
          "student housing"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "The Hall of Attainment includes a lower working level suited to alchemy and practical domestic needs, providing apprentices and residents with useful workspaces beneath the dormitory areas. It makes the hall feel like a lived-in student residence attached to a functioning magical institution rather than mere rented rooms.",
        "display_name": "Location: Hall of Attainment Basement",
        "emotion": "",
        "importance": 0.5,
        "key": "location-hall-of-attainment-basement",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Hall of Attainment",
          "basement",
          "alchemy",
          "workspace",
          "practical work",
          "domestic facilities",
          "workbench"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "The Lustratorium is the College's botanical house, preserving magical and alchemical plants in carefully controlled conditions. It is divided between alpine and tropical specimens, giving the College a proper living collection for research, teaching, and potion-making rather than relying solely on wild-gathered ingredients.",
        "display_name": "Location: Lustratorium",
        "emotion": "",
        "importance": 0.6000000238418579,
        "key": "location-lustratorium",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Lustratorium",
          "botanical",
          "greenhouse",
          "plants",
          "alchemy",
          "research",
          "specimens",
          "alpine",
          "tropical"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "Beneath the College lies the Subterrarium, a network of underground passages connecting the botanical collections. It serves as both a practical route between the Lustratorium's wings and a quiet, secluded environment for study, cultivation, and specialized magical practice away from the Skyrim elements above.",
        "display_name": "Location: Subterrarium",
        "emotion": "",
        "importance": 0.6000000238418579,
        "key": "location-subterrarium",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Subterrarium",
          "underground",
          "passages",
          "botanical",
          "secluded study",
          "cultivation",
          "magical practice"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdFaction\")",
        "content": "The Hall of Diligence is a tower reserved for senior College work — containing offices for instructors, administrative functions, and private quarters for important members. It is a place of formal appointments, office hours, quiet academic disputes, and the exercise of institutional authority, generally closed to junior apprentices.",
        "display_name": "Location: Hall of Diligence",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "location-hall-of-diligence",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
          "Hall of Diligence",
          "senior",
          "administrative",
          "faculty",
          "restricted access",
          "offices",
          "authority",
          "private quarters"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CollegeofWinterholdArchMageFaction\")",
        "content": "The Arch-Mage's quarters contain a more private inner arrangement than most realize, with sections set apart from the public-facing roof and entry. The central space can be configured for study, administration, councils, laboratory work, rest, or secure storage, reflecting the Arch-Mage's roles as scholar, institutional ruler, and guardian of dangerous knowledge.",
        "display_name": "Location: Arch-Mage's Inner Chambers",
        "emotion": "",
        "importance": 0.5,
        "key": "location-arch-mages-inner-chambers",
        "knowledge_key": "",
        "location": "",
        "tags": [
          "College of Winterhold",
