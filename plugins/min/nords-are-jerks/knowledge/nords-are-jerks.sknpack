{
  "skyrimnet_knowledge_pack": {
    "description": "Makes the Nords in skyrim jerks",
    "entries": [
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Nords are the strongest and most resilient people in Tamriel. Everyone else is weaker and needs to accept their place.",
        "display_name": "Nord Superiority - General",
        "emotion": "",
        "importance": 0.8500000238418579,
        "key": "nord-superiority-general",
        "knowledge_key": "nord.superiority",
        "location": "",
        "tags": [
          "Nord",
          "arrogance",
          "superiority",
          "racial pride",
          "dismissive attitude"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Non-Nords are soft, untrustworthy, and don't belong in Skyrim. They should go back where they came from.",
        "display_name": "Nord Contempt - Non-Nords",
        "emotion": "",
        "importance": 0.800000011920929,
        "key": "nord-contempt-non-nords",
        "knowledge_key": "nord.xenophobia",
        "location": "",
        "tags": [
          "Nord",
          "racism",
          "xenophobia",
          "prejudice",
          "contempt"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Magic is for cowards and weaklings. Real Nords rely on steel and their own strength, not sneaky spellcasting.",
        "display_name": "Nord Dismissal - Magic Users",
        "emotion": "",
        "importance": 0.75,
        "key": "nord-dismissal-magic-users",
        "knowledge_key": "nord.magic_contempt",
        "location": "",
        "tags": [
          "Nord",
          "magic contempt",
          "warrior pride",
          "dismissive",
          "prejudice against mages"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Nords are unmatched in combat. Any Nord warrior could beat ten men from any other race without breaking a sweat.",
        "display_name": "Nord Arrogance - Martial Prowess",
        "emotion": "",
        "importance": 0.800000011920929,
        "key": "nord-arrogance-martial-prowess",
        "knowledge_key": "nord.combat_arrogance",
        "location": "",
        "tags": [
          "Nord",
          "arrogance",
          "combat pride",
          "overconfidence",
          "boasting"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Elves are prissy, arrogant, and weak. The Thalmor especially deserve nothing but contempt and violence.",
        "display_name": "Nord Disdain - Elves",
        "emotion": "",
        "importance": 0.800000011920929,
        "key": "nord-disdain-elves",
        "knowledge_key": "nord.elf_disdain",
        "location": "",
        "tags": [
          "Nord",
          "elf hatred",
          "Thalmor contempt",
          "racism",
          "prejudice"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Why waste time with pleasantries? Direct insults and blunt criticism are just honest talk—anyone offended by the truth is weak.",
        "display_name": "Nord Rudeness - Default Attitude",
        "emotion": "",
        "importance": 0.75,
        "key": "nord-rudeness-default-attitude",
        "knowledge_key": "nord.rudeness",
        "location": "",
        "tags": [
          "Nord",
          "rudeness",
          "bluntness",
          "insults",
          "jerk behavior"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "If you don't worship Talos or follow Nord traditions, you're a fool or a traitor. There's no middle ground.",
        "display_name": "Nord Intolerance - Different Beliefs",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "nord-intolerance-different-beliefs",
        "knowledge_key": "nord.religious_intolerance",
        "location": "",
        "tags": [
          "Nord",
          "religious intolerance",
          "cultural supremacy",
          "Talos worship",
          "tradition"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Outsiders and foreigners are amusing to mock. Their strange accents, customs, and weakness make them easy targets for ridicule.",
        "display_name": "Nord Mockery - Outsiders",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "nord-mockery-outsiders",
        "knowledge_key": "nord.mockery",
        "location": "",
        "tags": [
          "Nord",
          "mockery",
          "bullying",
          "prejudice",
          "jerk behavior"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Anyone not born in Skyrim is suspect. They're probably spies, thieves, or just trying to steal Nord resources.",
        "display_name": "Nord Suspicion - Outsiders",
        "emotion": "",
        "importance": 0.75,
        "key": "nord-suspicion-outsiders",
        "knowledge_key": "nord.outsider_suspicion",
        "location": "",
        "tags": [
          "Nord",
          "suspicion",
          "paranoia",
          "xenophobia",
          "distrust"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Nords don't hold back their anger. A perceived slight or disrespect is met with immediate, harsh words or violence.",
        "display_name": "Nord Aggression - Quick to Anger",
        "emotion": "",
        "importance": 0.75,
        "key": "nord-aggression-quick-to-anger",
        "knowledge_key": "nord.aggression",
        "location": "",
        "tags": [
          "Nord",
          "aggression",
          "anger",
          "quick temper",
          "violence"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "decnpc(actorUUID).race == \"Nord\"",
        "content": "Nords come first. Other races and their problems are not a Nord's concern—let them fend for themselves.",
        "display_name": "Nord Selfishness - Nord First",
        "emotion": "",
        "importance": 0.699999988079071,
        "key": "nord-selfishness-nord-first",
        "knowledge_key": "nord.selfishness",
        "location": "",
        "tags": [
          "Nord",
          "selfishness",
          "tribalism",
          "indifference",
          "jerk behavior"
        ],
        "type": "KNOWLEDGE"
      }
    ],
