{% if render_mode == "full" or render_mode == "thoughts" or render_mode == "transform" %}
    {% set memories = get_relevant_memories(actorUUID) %}
    {% if length(memories) > 0 %}
        {% if render_mode == "full" and default(stable_split, false) %}
        ## {{ decnpc(actorUUID).name }}'s Potentially Relevant Memories
        {% else %}
        ### {{ decnpc(actorUUID).name }}'s Potentially Relevant Memories
        {% endif %}
        {# In NPC replies only the four most relevant memories: a long list crowds out the scene for a small model. #}
        {% set _memCap = 99 %}{% if render_mode == "full" and default(stable_split, false) %}{% set _memCap = 3 %}{% endif %}
        {% for memory in memories %}{% if loop.index <= _memCap %}
            {% set timeDiff = gameTimeNumeric - memory.memory.game_time %}
            {% set timeIndicator = "" %}
            {% if timeDiff > 31536000 %}{% set timeIndicator = "[Over a year ago] " %}
            {% else if timeDiff > 5184000 %}{% set timeIndicator = "[Several months ago] " %}
            {% else if timeDiff > 2592000 %}{% set timeIndicator = "[Last month] " %}
            {% else if timeDiff > 1209600 %}{% set timeIndicator = "[Several weeks ago] " %}
            {% else if timeDiff > 604800 %}{% set timeIndicator = "[Last week] " %}
            {% else if timeDiff > 172800 %}{% set timeIndicator = "[Several days ago] " %}
            {% else if timeDiff > 86400 %}{% set timeIndicator = "[Yesterday] " %}
            {% else if timeDiff > 28800 %}{% set timeIndicator = "[Many hours ago] " %}
            {% else if timeDiff > 14400 %}{% set timeIndicator = "[Earlier today] " %}
            {% else if timeDiff > 7200 %}{% set timeIndicator = "[A few hours ago] " %}
            {% else if timeDiff > 3600 %}{% set timeIndicator = "[About an hour ago] " %}
            {% else if timeDiff > 1800 %}{% set timeIndicator = "[A while ago] " %}
            {% endif %}
            {{ loop.index }}. {% if not memory.isOwn %}[experienced as {{ memory.originName }}] {% endif %}{{ timeIndicator }}{% if memory.memory.season != season and memory.memory.season != "unknown" %}[in {{ memory.memory.season }}] {% endif %}**{{ memory.memory.content }}** ({{ memory.memory.emotion }})
        {% endif %}{% endfor %}
    {% endif %}
{% endif %}
