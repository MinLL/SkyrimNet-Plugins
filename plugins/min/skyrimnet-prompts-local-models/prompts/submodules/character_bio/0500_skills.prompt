{# Left out of the cached NPC profile ("stable"): a small model answers better with less of it. #}
{% set _profile = render_mode == "thoughts" or render_mode == "transform" or (render_mode == "full" and not default(stable_split, false)) %}
{% if _profile or render_mode == "bio_skills" %}
    {% if _profile %}
        ## Skills & Combat
    {% endif %}
    {% block skills %}{% endblock %}
{% endif %}
